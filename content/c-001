            if (!grid) return;

            const filtered = archiveActiveTag === 'ALL'
                ? ARCHIVE_ITEMS
                : ARCHIVE_ITEMS.filter((item) => item.tag === archiveActiveTag);

            const visible = filtered.slice(0, archiveVisibleCount);

            grid.innerHTML = visible.map((item) => `
                <a href="#archive/${encodeURIComponent(item.id)}" onclick="openArchive('${item.id}'); return false;"
                   class="block text-left bg-white rounded-3xl p-6 sm:p-8 border border-line shadow-sm hover:border-accent/40 hover:shadow-md transition group">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-accent-bg text-accent text-[11px] font-bold mb-3">${escapeHtml(item.badgeLabel)}</span>
                    <h3 class="text-lg sm:text-xl font-extrabold text-ink mb-1 group-hover:text-accent transition">${escapeHtml(item.title)}</h3>
                    ${item.subtitle ? `<p class="text-ink-muted text-sm font-semibold mb-3">${escapeHtml(item.subtitle)}</p>` : ''}
                    <p class="text-ink-muted text-sm leading-relaxed mb-4 [text-wrap:balance]">${escapeHtml(item.cardSummary)}</p>
                    <span class="inline-flex items-center gap-1 text-accent text-sm font-bold">
                        전체 보기
                        <i data-lucide="arrow-right" class="w-4 h-4" aria-hidden="true"></i>
                    </span>
                </a>
            `).join('');

            const emptyState = document.getElementById('archive-empty-state');
            if (emptyState) emptyState.classList.toggle('hidden', filtered.length > 0);

            const loadMoreWrap = document.getElementById('archive-load-more');
            if (loadMoreWrap) loadMoreWrap.classList.toggle('hidden', filtered.length <= archiveVisibleCount);

            lucide.createIcons();
        }

        function setArchiveFilter(tag) {
            archiveActiveTag = tag;
            archiveVisibleCount = ARCHIVE_PAGE_SIZE;

            document.querySelectorAll('.archive-filter-btn').forEach((btn) => {
                const isActive = btn.getAttribute('data-tag') === tag;
                btn.className = isActive
                    ? 'archive-filter-btn px-3 py-1 rounded-full bg-accent text-white text-[11px] font-bold transition'
                    : 'archive-filter-btn px-3 py-1 rounded-full bg-white border border-line text-ink-muted text-[11px] font-bold transition hover:border-accent/40';
            });

            renderArchiveCards();
        }

        function loadMoreArchive() {
            archiveVisibleCount += ARCHIVE_PAGE_SIZE;
            renderArchiveCards();
        }

        // 글 화면 타이포 (위계: 글 제목 h1 > 섹션 제목 h2 > 소제목 h3 > 본문)
        const ARTICLE_P_CLASS = 'text-ink-body text-base leading-[1.8] mb-6';
        const ARTICLE_QUOTE_CLASS = 'bg-accent-bg border border-accent/20 rounded-xl px-5 py-4 my-6';

        function renderArticleParagraph(text) {
            // 원고의 문장별 줄바꿈(\n)은 화면에서 이어 붙여 자연스러운 문단으로 표시 (데이터는 원문 그대로 유지)
            return `<p class="${ARTICLE_P_CLASS}">${formatText(text).replace(/\n/g, ' ')}</p>`;
        }

        function renderArticleQuote(text) {
            return `<div class="${ARTICLE_QUOTE_CLASS}"><p class="text-ink text-base font-semibold leading-relaxed">${formatText(text)}</p></div>`;
        }

        // sections 배열을 글 본문 HTML로 변환
        function renderArchiveSections(sections) {
            return (sections || []).map((section, index) => {
                const heading = section.heading
                    ? `<h2 class="text-xl sm:text-[22px] font-extrabold text-ink leading-snug mb-5 ${index === 0 ? '' : 'mt-12 pt-10 border-t border-line'}">${escapeHtml(section.heading)}</h2>`
                    : '';
                const paragraphs = (section.paragraphs || []).map(renderArticleParagraph).join('');
                const quote = section.quote ? renderArticleQuote(section.quote) : '';
                const afterQuote = (section.afterQuote || []).map(renderArticleParagraph).join('');
                const blocks = (section.blocks || []).map(renderArchiveBlock).join('');
                return `<section>${heading}${paragraphs}${quote}${afterQuote}${blocks}</section>`;
            }).join('');
        }

        function renderArchiveBlock(block) {
            if (block.type === 'sub') {
                return `<h3 class="text-[17px] sm:text-lg font-bold text-ink leading-snug mt-10 mb-3">${formatText(block.text)}</h3>`;
            }
            if (block.type === 'list') {
                const items = (block.items || [])
                    .map((item) => `<li>${formatText(item)}</li>`)
                    .join('');
                return `<ul class="list-disc pl-5 space-y-2 mb-6 text-ink-body text-base leading-relaxed marker:text-accent">${items}</ul>`;
            }
            if (block.type === 'quote') {
                return renderArticleQuote(block.text);
            }
            return renderArticleParagraph(block.text);
        }

        // 글 화면 표시. 없는 id면 false 반환
        function showArchiveArticle(id) {
            const item = ARCHIVE_ITEMS.find((entry) => entry.id === id);
            const container = document.getElementById('archive-article');
            if (!item || !container) return false;

            const promptHtml = item.prompt ? `
                <span class="block text-accent font-bold text-xs uppercase tracking-widest mt-12 mb-3">Try This · Prompt</span>
                <div class="relative mb-6">
                    <pre id="archive-article-prompt" class="bg-ink text-white/90 rounded-xl p-4 sm:p-5 text-xs sm:text-sm font-mono whitespace-pre-wrap leading-relaxed pr-14">${escapeHtml(item.prompt)}</pre>
                    <button type="button" onclick="copyPrompt('archive-article-prompt')"
                            class="absolute top-3 right-3 inline-flex items-center justify-center w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-white transition"
                            aria-label="프롬프트 복사">
                        <i data-lucide="copy" class="w-4 h-4" aria-hidden="true"></i>
                    </button>
                </div>
            ` : '';

            const relatedHtml = item.related ? `
                <div class="mt-12 pt-8 border-t border-line">
                    <span class="block text-ink-light font-bold text-[11px] uppercase tracking-widest mb-2">Related</span>
                    <p class="text-ink-light text-sm">${escapeHtml(item.related)}</p>
                </div>
            ` : '';

            container.innerHTML = `
                <header class="mb-10 pb-8 border-b border-line">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-accent-bg text-accent text-[11px] font-bold mb-4">${escapeHtml(item.badgeLabel)}</span>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-ink leading-snug">${escapeHtml(item.title)}</h1>
                    ${item.subtitle ? `<p class="text-accent font-bold text-sm sm:text-base mt-3">${escapeHtml(item.subtitle)}</p>` : ''}
                </header>

                ${renderArchiveSections(item.sections)}
                ${promptHtml}
                ${relatedHtml}
            `;

            document.title = `${item.title} - 완결러들`;
            switchView('archive');
            currentArchiveId = id;
            return true;
        }

        function backToArchiveList() {
            switchView('main');
            scrollToSection('#tips');
        }

        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            closeSubscribePopup();
        });
        function copyPrompt(id) {
            const el = document.getElementById(id);
            if (!el) return;
            const text = el.textContent;
            navigator.clipboard.writeText(text)
                .then(() => showToast('클립보드에 복사되었습니다.'))
                .catch(() => showToast('복사에 실패했어요. 직접 선택해 복사해주세요.'));
        }
    </script>
</body>
</html>
