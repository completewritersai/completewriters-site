    <!-- Stibee Subscription Script -->
    <script type="text/javascript" src="https://resource.stibee.com/subscribe/stb_subscribe_form.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            setArchiveFilter('ALL');
            handleRoute();
            window.addEventListener('hashchange', handleRoute);
            window.addEventListener('popstate', handleRoute);

            // 구독 폼 제출 감지 및 예쁜 커스텀 팝업 띄우기
            const form = document.getElementById('stb_subscribe_form');
            if (form) {
                form.addEventListener('submit', (e) => {
                    const emailInput = document.getElementById('stb_email');
                    const policyCheckbox = document.getElementById('stb_policy');
                    
                    if (emailInput && emailInput.value && policyCheckbox && policyCheckbox.checked) {
                        const emailVal = emailInput.value;
                        setTimeout(() => {
                            showSubscribePopup(emailVal);
                        }, 500);
                    }
                });
            }
        });

        const DEFAULT_TITLE = document.title;
        // 화면 전환 시 스크롤은 switchView()/scrollToSection()이 직접 관리 (브라우저 자동 복원이 덮어쓰지 않게)
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        let currentArchiveId = null; // 현재 글 화면에 표시 중인 글 id
        let justSwitchedView = false; // switchView() 직후 같은 흐름의 scrollToSection()은 즉시 이동

        function switchView(viewName) {
            const views = {
                main: document.getElementById('view-main'),
                workflow: document.getElementById('view-workflow'),
                archive: document.getElementById('view-archive')
            };
            const target = views[viewName] ? viewName : 'main';
            const viewChanged = views[target].classList.contains('hidden');

            Object.entries(views).forEach(([name, el]) => {
                if (el) el.classList.toggle('hidden', name !== target);
            });

            if (target === 'workflow') selectWorkflowStep(1);

            if (target !== 'archive') {
                document.title = DEFAULT_TITLE;
                // 글 주소(#archive/<id>)에서 벗어나면 해시를 비워, 새로고침 시 글이 다시 열리지 않게 함
                if (location.hash.startsWith('#archive/')) {
                    setUrlSafely(location.pathname + location.search);
                }
                currentArchiveId = null;
            }

            // 다른 화면으로 넘어갈 때는 새 페이지처럼 즉시 맨 위로 이동.
            // (smooth 스크롤은 화면 전환 직후 이어지는 scrollToSection() 이동과 충돌해 목표 위치에 못 가는 경우가 있음)
            // 같은 화면 안에서의 이동은 scrollToSection()이 smooth로 처리
            if (viewChanged || target === 'archive') {
                window.scrollTo({ top: 0, behavior: 'instant' });
                justSwitchedView = true;
                setTimeout(() => { justSwitchedView = false; }, 0);
            }
            lucide.createIcons();
        }

        // 주소 해시 → 화면: #archive/<id>면 글 화면, 그 외에는 글 화면을 닫고 메인으로
        // 주소 변경 시도. 미리보기·data: 페이지처럼 주소 변경이 막힌 환경에서는 조용히 건너뜀 (화면 전환은 그대로 동작)
        function setUrlSafely(url) {
            try {
                history.pushState(null, '', url);
            } catch (e) {
                // 주소만 안 바뀔 뿐 동작에는 영향 없음
            }
        }

        // 카드 클릭: 주소 이동(hashchange)에 의존하지 않고 글 화면을 직접 연 뒤 주소를 갱신
        function openArchive(id) {
            if (!showArchiveArticle(id)) return;
            const hash = '#archive/' + encodeURIComponent(id);
            if (location.hash !== hash) setUrlSafely(hash);
        }

        function handleRoute() {
            const match = location.hash.match(/^#archive\/(.+)$/);
            if (match) {
                const id = decodeURIComponent(match[1]);
                // hashchange·popstate가 함께 발생해도 같은 글을 두 번 렌더링하지 않음
                if (id === currentArchiveId && !document.getElementById('view-archive').classList.contains('hidden')) return;
                if (showArchiveArticle(id)) return;
                backToArchiveList();
                return;
            }
            const archiveView = document.getElementById('view-archive');
            // 브라우저 뒤로가기로 글 화면을 벗어난 경우 → 목록 위치로 복귀
            if (archiveView && !archiveView.classList.contains('hidden')) {
                backToArchiveList();
            }
        }

        function selectWorkflowStep(stepNum) {
            // Update tabs
            const tabs = document.querySelectorAll('.workflow-tab-btn');
            tabs.forEach((btn, idx) => {
                if ((idx + 1) === stepNum) {
                    btn.className = 'workflow-tab-btn py-3 px-1 sm:px-3 rounded-xl text-center transition border border-accent bg-accent-bg text-accent font-bold text-xs sm:text-sm';
                } else {
                    btn.className = 'workflow-tab-btn py-3 px-1 sm:px-3 rounded-xl text-center transition border border-line bg-siteBg text-ink-muted font-bold text-xs sm:text-sm hover:border-ink-muted';
                }
            });

            // Update cards
            const cards = document.querySelectorAll('.workflow-step-card');
            cards.forEach((card) => {
                if (parseInt(card.getAttribute('data-step')) === stepNum) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });

            // Update indicator text
            const indicator = document.getElementById('current-step-indicator');
            if (indicator) {
                indicator.textContent = `Step 0${stepNum}`;
            }

            // Scroll slightly to the top of step container on mobile
            const container = document.getElementById('workflow-steps-container');
            if (container && window.innerWidth < 768) {
                container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            lucide.createIcons();
        }

        function showSubscribePopup(email) {
            const modal = document.getElementById('subscribe-popup-modal');
            const desc = document.getElementById('popup-desc');
            if (modal && desc) {
                desc.innerHTML = `<strong class="text-ink">${email}</strong>(으)로<br>앞으로 매주 금요일, 글쓰기 템플릿을 보내드릴게요.`;
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                lucide.createIcons();
            }
        }

        function closeSubscribePopup() {
            const modal = document.getElementById('subscribe-popup-modal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        function scrollToSection(targetHash) {
            const behavior = justSwitchedView ? 'instant' : 'smooth';
            // 모바일 메뉴가 열린 채로 위치를 계산하면, 메뉴가 닫히며 줄어든 높이만큼 목표보다 아래로 지나침 → 먼저 닫고 계산
            closeMobileMenu();
            if (targetHash) {
                const el = document.querySelector(targetHash);
                if (el) {
                    // 상단 고정 헤더에 섹션 시작 부분이 가려지지 않도록 헤더 높이만큼 덜 내려감
                    const header = document.querySelector('body > header');
                    const offset = header ? header.offsetHeight : 0;
                    const top = el.getBoundingClientRect().top + window.scrollY - offset;
                    window.scrollTo({ top: Math.max(0, top), behavior });
                }
            } else {
                window.scrollTo({ top: 0, behavior });
            }
            lucide.createIcons();
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const willOpen = menu.classList.contains('hidden');
            menu.classList.toggle('hidden');

            const btn = document.getElementById('mobile-menu-btn');
            btn.setAttribute('aria-expanded', String(willOpen));
            btn.innerHTML = willOpen
                ? '<i data-lucide="x" class="w-5 h-5 text-ink" aria-hidden="true"></i>'
                : '<i data-lucide="menu" class="w-5 h-5 text-ink" aria-hidden="true"></i>';
            lucide.createIcons();
        }

        function closeMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            if (menu.classList.contains('hidden')) return;
            menu.classList.add('hidden');

            const btn = document.getElementById('mobile-menu-btn');
            btn.setAttribute('aria-expanded', 'false');
            btn.innerHTML = '<i data-lucide="menu" class="w-5 h-5 text-ink" aria-hidden="true"></i>';
            lucide.createIcons();
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            toastMsg.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // Archive 데이터 (새 아카이브는 이 배열에 객체 하나만 추가하면 됨)
